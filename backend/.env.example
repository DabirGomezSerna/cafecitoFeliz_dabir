# Cafecito Feliz — backend configuration
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# Port the API listens on. The frontend's REACT_APP_API_URL must agree with this.
PORT=4000

# "development" or "production". In production the auth cookie gains the Secure
# flag (HTTPS only) and 500 responses stop including a stack trace.
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://localhost:27017/cafecito-pos
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/cafecito-pos?retryWrites=true&w=majority
# NOTE: a standalone mongod does not support multi-document transactions. See the
# comment block in services/salesService.js before changing how sales are written.
DB_CONNECTION_STRING=mongodb://localhost:27017/cafecito-pos

# Secret used to sign session JWTs. The server refuses to boot without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value invalidates every existing session.
JWT_SECRET=

# How long a staff session lasts. Note that a user's role is carried inside the
# token, so a role change does not take effect until they log in again — up to
# this duration. Shorten it if you need promotions/demotions to apply sooner.
JWT_EXPIRES_IN=7d

# Browser origin allowed to send credentialed requests. Must be the exact origin
# the frontend is served from; a wildcard is not permitted with cookies.
CLIENT_ORIGIN=http://localhost:3000

# Bootstrap administrator created by `npm run seed`. This is the only way an
# admin account can be created: POST /api/auth/register always forces the
# "vendor" role, so the running application cannot mint an administrator.
# Set a real password here before using this anywhere but a local machine.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@cafecitofeliz.com
SEED_ADMIN_PASSWORD=
